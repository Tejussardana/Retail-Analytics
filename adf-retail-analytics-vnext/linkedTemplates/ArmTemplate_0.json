							},
							"name": "sinkFinalSales"
						},
						{
							"dataset": {
								"referenceName": "DS_SQL_Rejected_Orders",
								"type": "DatasetReference"
							},
							"name": "sinkRejectedOrders"
						}
					],
					"transformations": [
						{
							"name": "selectOrders"
						},
						{
							"name": "selectCustomers"
						},
						{
							"name": "selectProducts"
						},
						{
							"name": "selectPayments"
						},
						{
							"name": "selectReturns"
						},
						{
							"name": "derivedOrdersClean"
						},
						{
							"name": "derivedProductClean"
						},
						{
							"name": "derivedPaymentClean"
						},
						{
							"name": "derivedReturnsClean"
						},
						{
							"name": "JoinOrdersCustomers"
						},
						{
							"name": "JoinProducts"
						},
						{
							"name": "JoinPayments"
						},
						{
							"name": "JoinReturns"
						},
						{
							"name": "DerivedBusinessColumns"
						},
						{
							"name": "derivedRejectedReason"
						},
						{
							"name": "splitValidRejected"
						},
						{
							"name": "selectFinalSales"
						},
						{
							"name": "selectRejectedOrders"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustomerID as string,",
						"          CustomerName as string,",
						"          Email as string,",
						"          City as string,",
						"          State as string,",
						"          Region as string,",
						"          CustomerSegment as string,",
						"          SignupDate as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcCustomers",
						"source(output(",
						"          OrderID as string,",
						"          OrderDate as string,",
						"          CustomerID as string,",
						"          ProductID as string,",
						"          Quantity as short,",
						"          Discount as short,",
						"          OrderStatus as string,",
						"          SalesChannel as string,",
						"          SalesRep as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcOrders",
						"source(output(",
						"          PaymentID as string,",
						"          OrderID as string,",
						"          PaymentDate as date,",
						"          PaymentMode as string,",
						"          PaymentStatus as string,",
						"          AmountPaid as short",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcPayments",
						"source(output(",
						"          ProductID as string,",
						"          ProductName as string,",
						"          Category as string,",
						"          SubCategory as string,",
						"          Brand as string,",
						"          UnitPrice as short,",
						"          CostPrice as short,",
						"          IsActive as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcProducts",
						"source(output(",
						"          ReturnID as string,",
						"          OrderID as string,",
						"          ReturnDate as date,",
						"          ReturnReason as string,",
						"          RefundAmount as short,",
						"          ReturnStatus as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcReturns",
						"srcOrders select(mapColumn(",
						"          OrderID,",
						"          OrderDate,",
						"          CustomerID,",
						"          ProductID,",
						"          Quantity,",
						"          Discount,",
						"          OrderStatus,",
						"          SalesChannel,",
						"          SalesRep",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectOrders",
						"srcCustomers select(mapColumn(",
						"          Cust_CustomerID = CustomerID,",
						"          CustomerName,",
						"          Email,",
						"          City,",
						"          State,",
						"          Region,",
						"          CustomerSegment,",
						"          SignupDate",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectCustomers",
						"srcProducts select(mapColumn(",
						"          Prod_ProductID = ProductID,",
						"          ProductName,",
						"          Category,",
						"          SubCategory,",
						"          Brand,",
						"          UnitPrice,",
						"          CostPrice,",
						"          IsActive",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectProducts",
						"srcPayments select(mapColumn(",
						"          PaymentID,",
						"          PayOrderID = OrderID,",
						"          PaymentDate,",
						"          PaymentMode,",
						"          PaymentStatus,",
						"          AmountPaid",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectPayments",
						"srcReturns select(mapColumn(",
						"          ReturnID,",
						"          Return_OrderID = OrderID,",
						"          ReturnDate,",
						"          ReturnReason,",
						"          RefundAmount,",
						"          ReturnStatus",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectReturns",
						"selectOrders derive(Clean_OrdersDate = toDate(OrderDate),",
						"          Clean_quantity = toInteger(Quantity),",
						"          Clean_Discount = toDecimal(Discount),",
						"          Clean_OrderStatus = trim(OrderStatus),",
						"          Clean_CustomerID = trim(CustomerID),",
						"          Clean_ProductID = trim(ProductID)) ~> derivedOrdersClean",
						"selectProducts derive(Clean_UnitPrice = toDecimal(UnitPrice),",
						"          Clean_CostPrice = toDecimal(CostPrice),",
						"          Clean_IsActive = trim(toString(IsActive))) ~> derivedProductClean",
						"selectPayments derive(Clean_AmountPaid = toDecimal(AmountPaid),",
						"          Clean_PaymentStatus = trim(PaymentStatus)) ~> derivedPaymentClean",
						"selectReturns derive(Clean_RefundAmount = iif(isNull(RefundAmount), toDecimal(0), toDecimal(RefundAmount)),",
						"          Clean_ReturnStatus = trim(ReturnStatus)) ~> derivedReturnsClean",
						"derivedOrdersClean, selectCustomers join(Clean_CustomerID == Cust_CustomerID,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> JoinOrdersCustomers",
						"JoinOrdersCustomers, derivedProductClean join(Clean_ProductID == Prod_ProductID,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> JoinProducts",
						"JoinProducts, derivedPaymentClean join(OrderID == PayOrderID,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> JoinPayments",
						"JoinPayments, derivedReturnsClean join(OrderID == Return_OrderID,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> JoinReturns",
						"JoinReturns derive(GrossAmount = Clean_quantity * Clean_UnitPrice,",
						"          DiscountAmount = Clean_Discount,",
						"          NetAmount = (Clean_quantity * Clean_UnitPrice) - Clean_Discount,",
						"          GSTAmount = ( (Clean_quantity * Clean_UnitPrice) - Clean_Discount ) * 0.18,",
						"          FinalAmount = (Clean_quantity * Clean_UnitPrice) - Clean_Discount,",
						"          RefundAmountClean = iif(isNull(Clean_RefundAmount), toDecimal(0), Clean_RefundAmount),",
						"          AdjustedFinalAmount = ( (Clean_quantity * Clean_UnitPrice) - Clean_Discount ) - iif(isNull(Clean_RefundAmount), toDecimal(0), Clean_RefundAmount),",
						"          CostAmount = Clean_quantity * Clean_CostPrice,",
						"          ProfitAmount = ( (Clean_quantity * Clean_UnitPrice) - Clean_Discount ) - (Clean_quantity * Clean_CostPrice),",
						"          ProfitMargin = iif( ((Clean_quantity * Clean_UnitPrice) - Clean_Discount)==0  || isNull((Clean_quantity * Clean_UnitPrice) - Clean_Discount), toDecimal(0), ( (( (Clean_quantity * Clean_UnitPrice) - Clean_Discount ) - (Clean_quantity * Clean_CostPrice))  /  ((Clean_quantity * Clean_UnitPrice) - Clean_Discount) ) *100 ),",
						"          PaymentFlag = iif(Clean_PaymentStatus == 'Success' , 'Yes', 'No'),",
						"          ReturnFlag = iif(!isNull(ReturnID) && Clean_ReturnStatus == 'Approved', 'Yes', 'No'),",
						"          RevenueCategory = iif( (( (Clean_quantity * Clean_UnitPrice) - Clean_Discount ) - iif(isNull(Clean_RefundAmount), toDecimal(0), Clean_RefundAmount)) >= 10000, 'High Revenue' , \r",
						"iif( ( (Clean_quantity * Clean_UnitPrice) - Clean_Discount ) - iif(isNull(Clean_RefundAmount), toDecimal(0), Clean_RefundAmount)>=5000, 'Medium Revenue', 'Low Revenue'))) ~> DerivedBusinessColumns",
						"DerivedBusinessColumns derive(RejectReason = iif(isNull(OrderID) || trim(OrderID) == '', 'Missing OrderID',\r",
						"iif(isNull(Clean_OrdersDate), 'Invalid OrderDate',\r",
						"iif(isNull(Clean_quantity) || Clean_quantity <= 0, 'Invalid Quantity',\r",
						"iif(isNull(Clean_OrderStatus) || Clean_OrderStatus == '', 'Missing OrderStatus',\r",
						"iif(isNull(Cust_CustomerID), 'Unknown CustomerID',\r",
						"iif(isNull(Prod_ProductID), 'Unknown ProductID',\r",
						"iif(Clean_OrderStatus == 'Pending', 'Pending Order',\r",
						"iif(Clean_OrderStatus == 'Cancelled', 'Cancelled Order',\r",
						"iif(Clean_OrderStatus == 'Returned', 'Returned Order',\r",
						"iif(isNull(Clean_PaymentStatus), 'Missing Payment Record',\r",
						"iif(Clean_PaymentStatus == 'Failed', 'Payment Failed',\r",
						"iif(Clean_PaymentStatus == 'Pending', 'Payment Pending',\r",
						"iif(Clean_PaymentStatus == 'Refunded', 'Payment Refunded',\r",
						"iif(Clean_PaymentStatus != 'Success', 'Unsuccessful Payment',\r",
						"'Valid'))))))))))))))) ~> derivedRejectedReason",
						"derivedRejectedReason split(RejectReason == 'Valid',",
						"     disjoint: false) ~> splitValidRejected@(validOrders, rejectedOrders)",
						"splitValidRejected@validOrders select(mapColumn(",
						"          OrderID,",
						"          OrderDate = Clean_OrdersDate,",
						"          CustomerID,",
						"          CustomerName,",
						"          Email,",
						"          City,",
						"          State,",
						"          Region,",
						"          CustomerSegment,",
						"          ProductID,",
						"          ProductName,",
						"          Category,",
						"          SubCategory,",
						"          Brand,",
						"          Quantity = Clean_quantity,",
						"          Discount = Clean_Discount,",
						"          OrderStatus = Clean_OrderStatus,",
						"          SalesChannel,",
						"          SalesRep,",
						"          PaymentID,",
						"          PaymentDate,",
						"          PaymentMode,",
						"          PaymentStatus = Clean_PaymentStatus,",
						"          AmountPaid = Clean_AmountPaid,",
						"          ReturnID,",
						"          ReturnDate,",
						"          ReturnReason,",
						"          ReturnStatus = Clean_ReturnStatus,",
						"          RefundAmount = RefundAmountClean,",
						"          UnitPrice = Clean_UnitPrice,",
						"          CostPrice = Clean_CostPrice,",
						"          GrossAmount,",
						"          DiscountAmount,",
						"          NetAmount,",
						"          GSTAmount,",
						"          FinalAmount,",
						"          AdjustedFinalAmount,",
						"          CostAmount,",
						"          ProfitAmount,",
						"          ProfitMargin,",
						"          PaymentFlag,",
						"          ReturnFlag,",
						"          RevenueCategory",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectFinalSales",
						"splitValidRejected@rejectedOrders select(mapColumn(",
						"          OrderID,",
						"          OrderDate,",
						"          CustomerID,",
						"          ProductID,",
						"          Quantity,",
						"          Discount,",
						"          OrderStatus,",
						"          SalesChannel,",
						"          SalesRep,",
						"          PaymentStatus = Clean_PaymentStatus,",
						"          ReturnStatus = Clean_ReturnStatus,",
						"          RejectReason",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectRejectedOrders",
						"selectFinalSales sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          OrderID as string,",
						"          OrderDate as date,",
						"          CustomerID as string,",
						"          CustomerName as string,",
						"          Email as string,",
						"          City as string,",
						"          State as string,",
						"          Region as string,",
						"          CustomerSegment as string,",
						"          ProductID as string,",
						"          ProductName as string,",
						"          Category as string,",
						"          SubCategory as string,",
						"          Brand as string,",
						"          Quantity as integer,",
						"          Discount as decimal(10,4),",
						"          OrderStatus as string,",
						"          SalesChannel as string,",
						"          SalesRep as string,",
						"          PaymentID as string,",
						"          PaymentDate as date,",
						"          PaymentMode as string,",
						"          PaymentStatus as string,",
						"          AmountPaid as decimal(18,2),",
						"          ReturnID as string,",
						"          ReturnDate as date,",
						"          ReturnReason as string,",
						"          ReturnStatus as string,",
						"          RefundAmount as decimal(18,2),",
						"          UnitPrice as decimal(18,2),",
						"          CostPrice as decimal(18,2),",
						"          GrossAmount as decimal(18,2),",
						"          DiscountAmount as decimal(18,2),",
						"          NetAmount as decimal(18,2),",
						"          GSTAmount as decimal(18,2),",
						"          FinalAmount as decimal(18,2),",
						"          AdjustedFinalAmount as decimal(18,2),",
						"          CostAmount as decimal(18,2),",
						"          ProfitAmount as decimal(18,2),",
						"          ProfitMargin as decimal(10,2),",
						"          PaymentFlag as string,",
						"          ReturnFlag as string,",
						"          RevenueCategory as string,",
						"          LoadDateTime as timestamp",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          OrderID,",
						"          OrderDate,",
						"          CustomerID,",
						"          CustomerName,",
						"          Email,",
						"          City,",
						"          State,",
						"          Region,",
						"          CustomerSegment,",
						"          ProductID,",
						"          ProductName,",
						"          Category,",
						"          SubCategory,",
						"          Brand,",
						"          Quantity,",
						"          Discount,",
						"          OrderStatus,",
						"          SalesChannel,",
						"          SalesRep,",
						"          PaymentID,",
						"          PaymentDate,",
						"          PaymentMode,",
						"          PaymentStatus,",
						"          AmountPaid,",
						"          ReturnID,",
						"          ReturnDate,",
						"          ReturnReason,",
						"          ReturnStatus,",
						"          RefundAmount,",
						"          UnitPrice,",
						"          CostPrice,",
						"          GrossAmount,",
						"          DiscountAmount,",
						"          NetAmount,",
						"          GSTAmount,",
						"          FinalAmount,",
						"          AdjustedFinalAmount,",
						"          CostAmount,",
						"          ProfitAmount,",
						"          ProfitMargin,",
						"          PaymentFlag,",
						"          ReturnFlag,",
						"          RevenueCategory",
						"     )) ~> sinkFinalSales",
						"selectRejectedOrders sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          RejectedID as integer,",
						"          OrderID as string,",
						"          OrderDate as string,",
						"          CustomerID as string,",
						"          ProductID as string,",
						"          Quantity as string,",
						"          Discount as string,",
						"          OrderStatus as string,",
						"          SalesChannel as string,",
						"          SalesRep as string,",
						"          PaymentStatus as string,",
						"          ReturnStatus as string,",
						"          RejectReason as string,",
						"          SourceFileName as string,",
						"          RejectedDateTime as timestamp",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          OrderID,",
						"          OrderDate,",
						"          CustomerID,",
						"          ProductID,",
						"          Quantity,",
						"          Discount,",
						"          OrderStatus,",
						"          SalesChannel,",
						"          SalesRep,",
						"          PaymentStatus,",
						"          ReturnStatus,",
						"          RejectReason",
						"     )) ~> sinkRejectedOrders"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Customers_Raw_csv')]",
				"[concat(variables('factoryId'), '/datasets/DS_Orders_Raw_CSV')]",
				"[concat(variables('factoryId'), '/datasets/DS_Payments_Raw_csv')]",
				"[concat(variables('factoryId'), '/datasets/DS_Products_raw_csv')]",
				"[concat(variables('factoryId'), '/datasets/DS_Returns_raw_csv')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_Final_Sales_Analytics')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_Rejected_Orders')]"
			]
